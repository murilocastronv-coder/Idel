# Copie para .env no seu computador. Na Render, configure no painel (Environment).

# Obrigatório: conexão com o PostgreSQL
DATABASE_URL=postgresql://usuario:senha@localhost:5432/muidle

# Opcional: schema do PostgreSQL onde ficam as tabelas do jogo (padrão: public).
# Use outro nome para dividir o banco com outros projetos sem conflito.
PG_SCHEMA=muidle

# Porta local (a Render define automaticamente)
PORT=3000

# Opcional: e-mails de recuperação de senha via Resend (https://resend.com)
# Sem isso, a recuperação continua funcionando pelo código de recuperação,
# e o link de redefinição aparece apenas no log do servidor.
RESEND_API_KEY=
MAIL_FROM=MU Idle Legends <nao-responda@seudominio.com>

# Opcional: endereço público usado nos links dos e-mails.
# Na Render não precisa (usa RENDER_EXTERNAL_URL automaticamente).
APP_URL=

# Opcional: force SSL no banco (true/false). Detectado automaticamente para a Render.
PGSSL=
